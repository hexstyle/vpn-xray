ROUTER_PROFILE=gl-mt3000-glinet
ROUTER_SSH=root@REPLACE_WITH_ROUTER_HOST

VPS_PROFILE=debian-13
VPS_SSH=root@REPLACE_WITH_VPS_HOST

# Optional. Derived automatically from ROUTER_SSH when left empty.
ROUTER_HOST=

# Optional. Defaults to ROUTER_HOST.
ROUTER_LAN_IP=

# Optional. Derived automatically from VPS_SSH when left empty.
VPS_HOST=

# Optional. Defaults to VPS_HOST.
XRAY_SERVER=

# Optional. Defaults to 443. Override if port 443 is already busy on the VPS.
# XRAY_PORT=443

# Optional. Generated automatically when left empty.
XRAY_UUID=
# Optional. Defaults to the selected VPS profile.
XRAY_SERVER_NAME=
XRAY_SHORT_ID=
XRAY_PUBLIC_KEY=
XRAY_PRIVATE_KEY=

# Optional advanced settings.
HOME_SUBNET=
XRAY_RULES_MODE=full
# Optional. Needed for background pull/sync of the shared rules list.
RULES_REPO_FETCH_URL=
# Optional. Needed only if this router is allowed to push local edits back to GitHub.
RULES_REPO_PUSH_URL=
RULES_ENABLE_PUSH=0
