# Advanced local installer only.
# The main user path is router-first:
#   1. ./bootstrap-router-ssh.sh root@192.168.8.1
#   2. open https://192.168.8.1/xray.html
#
# Use this file only when you explicitly want the workstation-driven path.
#
# Minimal advanced hello-world:
#   ROUTER_SSH=root@192.168.8.1
#   VPS_SSH=root@203.0.113.10
#
# Fill only ROUTER_SSH and VPS_SSH for the first install.
# Leave the generated Xray values empty unless you know exactly why you override them.

ROUTER_PROFILE=gl-mt3000-glinet
# Format: user@host or user@ip
ROUTER_SSH=root@REPLACE_WITH_ROUTER_HOST_OR_IP

VPS_PROFILE=debian-13
VPS_SSH=root@REPLACE_WITH_VPS_HOST_OR_IP

# Optional. Derived automatically from ROUTER_SSH when left empty.
ROUTER_HOST=

# Optional. Defaults to ROUTER_HOST.
ROUTER_LAN_IP=

# Optional. Derived automatically from VPS_SSH when left empty.
VPS_HOST=

# Optional. Defaults to VPS_HOST.
XRAY_SERVER=

# Optional. Defaults to 443. Override only if port 443 is already busy on the VPS.
# XRAY_PORT=443

# Optional. Generated automatically when left empty.
XRAY_UUID=
# Optional. Defaults to the selected VPS profile.
XRAY_SERVER_NAME=
XRAY_SHORT_ID=
XRAY_PUBLIC_KEY=
XRAY_PRIVATE_KEY=

# Optional advanced settings. Leave them unchanged for the first install.
HOME_SUBNET=
# Routing mode: selective routes only listed destinations through the VPS;
# full routes everything. install.env is authoritative — set
# PRESERVE_XRAY_RULES_MODE=1 if you would rather keep whatever the UI
# last applied across deploys.
XRAY_RULES_MODE=selective
PRESERVE_XRAY_RULES_MODE=0
# Optional. Leave empty for auto: enabled when RULES_REPO_FETCH_URL is set, disabled otherwise.
RULES_GIT_SYNC_ENABLED=
# Optional. Needed for background pull/sync of the shared rules list.
RULES_REPO_FETCH_URL=
# Optional. Needed only if this router is allowed to push local edits back to GitHub.
RULES_REPO_PUSH_URL=
RULES_GIT_AUTH_MODE=auto
RULES_GIT_HTTP_USERNAME=
RULES_GIT_HTTP_PASSWORD=
RULES_GIT_SSH_PRIVATE_KEY=
RULES_GIT_SSH_PRIVATE_KEY_FILE=
RULES_ENABLE_PUSH=0
