ROUTER_PROFILE=gl-mt3000-glinet
ROUTER_SSH=root@REPLACE_WITH_ROUTER_HOST

# Optional. Filled automatically by scripts/init-config.sh from ROUTER_SSH.
ROUTER_HOST=

# Optional. If empty, the deploy script assumes the LAN-side address equals ROUTER_HOST.
ROUTER_LAN_IP=

# Optional. Used for home-side WAN management rules. Default: 192.168.0.0/16
HOME_SUBNET=

# Local-only router mode. Leave as full until you need selective routing.
XRAY_RULES_MODE=full

# Optional shared-rules settings. Leave empty for the first deploy if you only
# want the router/VPS path and will configure Git sync later.
RULES_REPO_FETCH_URL=
RULES_REPO_PUSH_URL=
