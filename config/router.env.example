ROUTER_HOST=REPLACE_WITH_ROUTER_HOST

# Optional. If empty, the deploy script assumes the LAN-side address equals ROUTER_HOST.
ROUTER_LAN_IP=

# Optional. Used for home-side WAN management rules. Default: 192.168.0.0/16
HOME_SUBNET=

XRAY_SERVER=REPLACE_WITH_VPS_HOST

# Shared VLESS client/server UUID.
# Recommended: let scripts/init-config.sh generate it.
XRAY_UUID=REPLACE_WITH_XRAY_UUID

# Reality camouflage / SNI host.
# Recommended default is set by scripts/init-config.sh.
XRAY_SERVER_NAME=REPLACE_WITH_SERVER_NAME

# Reality public key paired with XRAY_PRIVATE_KEY in vps.env.
# Recommended: let scripts/init-config.sh generate it.
XRAY_PUBLIC_KEY=REPLACE_WITH_REALITY_PUBLIC_KEY

# Reality short ID.
# Recommended: let scripts/init-config.sh generate it.
XRAY_SHORT_ID=REPLACE_WITH_REALITY_SHORT_ID

# Optional shared-rules settings. Leave empty for the first deploy if you
# only want the router/VPS path and will configure Git sync later.
RULES_REPO_FETCH_URL=
RULES_REPO_PUSH_URL=
RULES_DEVICE_ID=gl-router
RULES_ENABLE_PUSH=0
XRAY_RULES_MODE=full
