#!/bin/sh /etc/rc.common

START=95
STOP=10
EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show runtime status"

NAME="codex-xray"
BIN="/usr/local/bin/codex-xray-core"
CONFIG="/etc/xray/codex-xray.json"
CONFIG_READY_FILE="/etc/xray/codex-xray.ready"
PIDFILE="/var/run/${NAME}.pid"
MPTCP_STATE_FILE="/var/run/${NAME}.mptcp"
LOG_DIR="/var/log/xray"
LOCAL_MANGLE_CHAIN="CODEX_XRAY_LOCAL"

current_switch_state() {
	local model gpio status

	if [ ! -f /proc/gl-hw-info/switch-button ] || [ ! -f /proc/gl-hw-info/model ]; then
		echo off
		return
	fi

	model="$(cat /proc/gl-hw-info/model 2>/dev/null || true)"
	gpio="$(cat /proc/gl-hw-info/switch-button 2>/dev/null || true)"

	if [ "$model" = "mt3000" ]; then
		status="$(grep "switch" /sys/kernel/debug/gpio 2>/dev/null | grep "hi" || true)"
	elif [ "$model" = "axt1800" ] || [ "$model" = "be3600" ]; then
		status="$(grep "$gpio" /sys/kernel/debug/gpio 2>/dev/null | grep "hi" || true)"
	elif [ "$model" = "a1300" ]; then
		status="$(grep "gpio0" /sys/kernel/debug/gpio 2>/dev/null | grep "lo" || true)"
	else
		status="$(grep "switch" /sys/kernel/debug/gpio 2>/dev/null | grep "lo" || true)"
	fi

	[ -n "$status" ] && echo on || echo off
}

path_requested() {
	[ "$(current_switch_state)" = 'on' ] || return 1
	[ -f "$CONFIG_READY_FILE" ] || return 1
	[ -s "$CONFIG" ] || return 1
	return 0
}

config_value() {
	local expr="$1"

	jsonfilter -i "$CONFIG" -e "$expr" 2>/dev/null | sed -n '1p'
}

server_port() {
	config_value '@.outbounds[0].settings.vnext[0].port'
}

server_address() {
	config_value '@.outbounds[0].settings.vnext[0].address'
}

resolve_server_ipv4s() {
	local addr resolved

	addr="$(server_address)"
	[ -n "$addr" ] || return 0

	case "$addr" in
		*[!0-9.]*)
			if command -v nslookup >/dev/null 2>&1; then
				resolved="$(nslookup "$addr" 2>/dev/null | sed -n 's/^Address [0-9]*: //p' | grep -E '^[0-9]+(\.[0-9]+){3}$' | sort -u || true)"
				[ -n "$resolved" ] && printf '%s\n' "$resolved"
			fi
			;;
		*)
			printf '%s\n' "$addr"
			;;
	esac
}

clear_local_tcpmss() {
	iptables -t mangle -D POSTROUTING -j "$LOCAL_MANGLE_CHAIN" 2>/dev/null || true
	iptables -t mangle -F "$LOCAL_MANGLE_CHAIN" 2>/dev/null || true
	iptables -t mangle -X "$LOCAL_MANGLE_CHAIN" 2>/dev/null || true
}

configure_local_tcpmss() {
	local port addr added=0

	port="$(server_port)"
	[ -n "$port" ] || return 0

	iptables -t mangle -N "$LOCAL_MANGLE_CHAIN" 2>/dev/null || true
	iptables -t mangle -F "$LOCAL_MANGLE_CHAIN"

	while IFS= read -r addr; do
		[ -n "$addr" ] || continue
		iptables -t mangle -A "$LOCAL_MANGLE_CHAIN" \
			-p tcp \
			-d "$addr" \
			--dport "$port" \
			--tcp-flags SYN,RST SYN \
			-j TCPMSS --clamp-mss-to-pmtu
		added=1
	done <<EOF
$(resolve_server_ipv4s || true)
EOF

	if [ "$added" = '1' ]; then
		iptables -t mangle -C POSTROUTING -j "$LOCAL_MANGLE_CHAIN" >/dev/null 2>&1 \
			|| iptables -t mangle -I POSTROUTING 1 -j "$LOCAL_MANGLE_CHAIN"
	else
		clear_local_tcpmss
	fi
}

save_mptcp_state() {
	[ -r /proc/sys/net/mptcp/enabled ] || return 0
	cat /proc/sys/net/mptcp/enabled > "$MPTCP_STATE_FILE"
	echo 0 > /proc/sys/net/mptcp/enabled
}

restore_mptcp_state() {
	[ -r /proc/sys/net/mptcp/enabled ] || return 0
	if [ -f "$MPTCP_STATE_FILE" ]; then
		cat "$MPTCP_STATE_FILE" > /proc/sys/net/mptcp/enabled 2>/dev/null || true
		rm -f "$MPTCP_STATE_FILE"
	fi
}

start() {
	path_requested || return 0
	[ -x "$BIN" ] || {
		echo "$BIN missing"
		return 1
	}

	mkdir -p "$LOG_DIR" /etc/xray /var/run

	"$BIN" run -test -config "$CONFIG" >/dev/null 2>&1 || {
		echo "config check failed"
		return 1
	}

	configure_local_tcpmss
	save_mptcp_state
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$BIN" -- run -config "$CONFIG"
}

stop() {
	start-stop-daemon -K -p "$PIDFILE" -x "$BIN" 2>/dev/null || true
	rm -f "$PIDFILE"
	clear_local_tcpmss
	restore_mptcp_state
}

restart() {
	stop
	sleep 1
	start
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "$NAME running"
		return 0
	fi
	echo "$NAME stopped"
	return 1
}
