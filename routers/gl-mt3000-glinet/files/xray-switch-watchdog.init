#!/bin/sh /etc/rc.common

START=97
STOP=08
USE_PROCD=1
CONFIG_READY_FILE="/etc/xray/codex-xray.ready"
ROUTER_CONFIG="/etc/xray/codex-xray.json"
ADMIN_CGI="/www/cgi-bin/xray-admin"

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
. /usr/share/vpn-xray/lib-common.sh

path_active() {
	local xpid rpid
	xpid="$(cat /var/run/codex-xray.pid 2>/dev/null || true)"
	rpid="$(cat /var/run/redsocks.pid 2>/dev/null || true)"
	[ -n "$xpid" ] && kill -0 "$xpid" 2>/dev/null || return 1
	[ -n "$rpid" ] && kill -0 "$rpid" 2>/dev/null || return 1
	iptables -t nat -S PREROUTING 2>/dev/null | grep -q "CODEX_TRANSPROXY" || return 1
	return 0
}

config_ready() {
	[ -f "'"$CONFIG_READY_FILE"'" ] && [ -s "'"$ROUTER_CONFIG"'" ]
}

log() {
	logger -t xray-switch-watchdog "$*"
}

SMOKE_MIN_INTERVAL=45
SMOKE_SETTLE_SECONDS=25
HEAL_COOLDOWN=90
SEVERE_FAILURE_THRESHOLD=2
OPENAI_FAILURE_THRESHOLD=4
LAST_SMOKE_FILE="/var/run/xray-switch-watchdog.last-smoke"
LAST_RECOVERY_FILE="/var/run/xray-switch-watchdog.last-recovery"
SEVERE_FAILURE_FILE="/var/run/xray-switch-watchdog.severe-failures"
OPENAI_FAILURE_FILE="/var/run/xray-switch-watchdog.openai-failures"

clear_health_state() {
	rm -f "$LAST_SMOKE_FILE" "$LAST_RECOVERY_FILE" "$SEVERE_FAILURE_FILE" "$OPENAI_FAILURE_FILE"
}

record_timestamp() {
	printf "%s\n" "$(date +%s)" > "$1"
}

seconds_since_file() {
	local file="$1" value now

	value="$(cat "$file" 2>/dev/null || true)"
	case "$value" in
		""|*[!0-9]*)
			echo 999999
			return 0
			;;
	esac

	now="$(date +%s)"
	if [ "$now" -lt "$value" ]; then
		echo 0
	else
		echo $((now - value))
	fi
}

increment_counter() {
	local file="$1" current

	current="$(cat "$file" 2>/dev/null || true)"
	case "$current" in
		""|*[!0-9]*)
			current=0
			;;
	esac
	current=$((current + 1))
	printf "%s\n" "$current" > "$file"
	printf "%s\n" "$current"
}

reset_counter() {
	rm -f "$1"
}

smoke_output() {
	[ -x "'"$ADMIN_CGI"'" ] || return 1
	REQUEST_METHOD=GET QUERY_STRING=action=smoke "'"$ADMIN_CGI"'" 2>/dev/null \
		| tr -d "\r" \
		| sed -n "/^{/,\$p" \
		| sed -n "1p"
}

smoke_status_ok() {
	printf "%s" "$1" | grep -q "\"status\":\"ok\""
}

smoke_https_ok() {
	printf "%s" "$1" | grep -q "\"https_ok\":true"
}

smoke_egress_ok() {
	printf "%s" "$1" | grep -q "\"egress_ok\":true"
}

smoke_openai_ok() {
	printf "%s" "$1" | grep -q "\"openai_ok\":true"
}

restart_runtime() {
	local output=""

	record_timestamp "$LAST_RECOVERY_FILE"
	if [ -x "'"$ADMIN_CGI"'" ]; then
		output="$(REQUEST_METHOD=GET QUERY_STRING=action=restart "'"$ADMIN_CGI"'" 2>/dev/null \
			| tr -d "\r" \
			| sed -n "/^{/,\$p" \
			| sed -n "1p" || true)"
		if printf "%s" "$output" | grep -q "\"ok\":true"; then
			return 0
		fi
	fi

	/etc/init.d/codex-transproxy stop >/dev/null 2>&1 || true
	/etc/init.d/codex-xray stop >/dev/null 2>&1 || true
	sleep 1
	/etc/gl-switch.d/xray.sh on >/dev/null 2>&1 || return 1
	return 0
}

maybe_smoke_recover() {
	local output="" severe_count=0 openai_count=0

	[ -x "'"$ADMIN_CGI"'" ] || return 0
	[ "$(seconds_since_file "$LAST_RECOVERY_FILE")" -ge "$SMOKE_SETTLE_SECONDS" ] || return 0
	[ "$(seconds_since_file "$LAST_SMOKE_FILE")" -ge "$SMOKE_MIN_INTERVAL" ] || return 0

	record_timestamp "$LAST_SMOKE_FILE"
	output="$(smoke_output || true)"

	if [ -z "$output" ]; then
		severe_count="$(increment_counter "$SEVERE_FAILURE_FILE")"
		reset_counter "$OPENAI_FAILURE_FILE"
		log "smoke probe unavailable severe_failures=$severe_count"
	elif smoke_status_ok "$output"; then
		reset_counter "$SEVERE_FAILURE_FILE"
		reset_counter "$OPENAI_FAILURE_FILE"
		return 0
	elif ! smoke_https_ok "$output" || ! smoke_egress_ok "$output"; then
		severe_count="$(increment_counter "$SEVERE_FAILURE_FILE")"
		reset_counter "$OPENAI_FAILURE_FILE"
		log "runtime smoke failed severe_failures=$severe_count output=$output"
		if [ "$severe_count" -lt "$SEVERE_FAILURE_THRESHOLD" ]; then
			return 0
		fi
		if [ "$(seconds_since_file "$LAST_RECOVERY_FILE")" -lt "$HEAL_COOLDOWN" ]; then
			return 0
		fi
		log "attempting runtime restart after severe smoke failure"
		restart_runtime >/dev/null 2>&1 || log "runtime restart failed after severe smoke failure"
		reset_counter "$SEVERE_FAILURE_FILE"
		reset_counter "$OPENAI_FAILURE_FILE"
	else
		openai_count="$(increment_counter "$OPENAI_FAILURE_FILE")"
		reset_counter "$SEVERE_FAILURE_FILE"
		log "OpenAI-only smoke failed openai_failures=$openai_count output=$output"
		if [ "$openai_count" -lt "$OPENAI_FAILURE_THRESHOLD" ]; then
			return 0
		fi
		if [ "$(seconds_since_file "$LAST_RECOVERY_FILE")" -lt "$HEAL_COOLDOWN" ]; then
			return 0
		fi
		log "attempting runtime restart after repeated OpenAI smoke failures"
		restart_runtime >/dev/null 2>&1 || log "runtime restart failed after repeated OpenAI smoke failures"
		reset_counter "$SEVERE_FAILURE_FILE"
		reset_counter "$OPENAI_FAILURE_FILE"
	fi
}

while true; do
	state="$(current_switch_state)"
	if [ "$state" = on ]; then
		if config_ready; then
			/etc/init.d/codex-xray refresh_egress_route >/dev/null 2>&1 || true
		fi
		if config_ready && ! path_active; then
			record_timestamp "$LAST_RECOVERY_FILE"
			reset_counter "$SEVERE_FAILURE_FILE"
			reset_counter "$OPENAI_FAILURE_FILE"
			/etc/gl-switch.d/xray.sh on >/dev/null 2>&1 || true
		elif config_ready; then
			maybe_smoke_recover
		fi
	else
		clear_health_state
		if path_active; then
			/etc/gl-switch.d/xray.sh off >/dev/null 2>&1 || true
		fi
	fi
	sleep 10
done
'
	procd_set_param respawn 10 5 0
	procd_close_instance
}
