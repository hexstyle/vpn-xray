#!/bin/sh /etc/rc.common

# Keeps the WAN-side uplink (repeater/bridge/tethering) that feeds the tunnel
# alive: light 30s probe, reconnect + re-pin route + flush conntrack on failure.
START=98
STOP=07
USE_PROCD=1

GUARD="/usr/bin/vpn-xray-uplink-guard"

start_service() {
	[ -x "$GUARD" ] || return 0
	procd_open_instance
	procd_set_param command "$GUARD"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}
