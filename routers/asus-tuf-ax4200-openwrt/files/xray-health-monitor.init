#!/bin/sh /etc/rc.common

START=99
STOP=06
USE_PROCD=1

HEALTH_LOG='/tmp/xray-health.tsv'
ALERT_LOG='/tmp/xray-health-alerts.log'
CRASH_LOG='/etc/xray-crash-log'
BREADCRUMB='/etc/xray-health-laststate'
INTERVAL=30
MAX_LINES=2880
MAX_BYTES=1048576
MAX_ALERT_LINES=200
MAX_CRASH_LINES=100
BREADCRUMB_INTERVAL=10

detect_unclean_shutdown() {
	[ -f "$BREADCRUMB" ] || return 0
	local prev_uptime now_uptime prev_epoch crash_line
	prev_uptime="$(sed -n 's/^uptime=//p' "$BREADCRUMB" | sed -n '1p')"
	prev_epoch="$(sed -n 's/^epoch=//p' "$BREADCRUMB" | sed -n '1p')"
	now_uptime="$(cut -d. -f1 /proc/uptime)"
	[ -n "$prev_uptime" ] || return 0
	if [ "$now_uptime" -lt "$prev_uptime" ] 2>/dev/null; then
		crash_line="$(date +%s)	CRASH_DETECTED reboot_after_uptime=${prev_uptime}s last_sample_epoch=${prev_epoch:-?}"
		local prev_state
		prev_state="$(grep '^state=' "$BREADCRUMB" | sed 's/^state=//' | sed -n '1p')"
		[ -n "$prev_state" ] && crash_line="$crash_line pre_crash=$prev_state"
		echo "$crash_line" >> "$CRASH_LOG"
		lc=$(wc -l < "$CRASH_LOG" 2>/dev/null || echo 0)
		if [ "$lc" -gt "$MAX_CRASH_LINES" ]; then
			tail -n "$((MAX_CRASH_LINES / 2))" "$CRASH_LOG" > "${CRASH_LOG}.tmp"
			mv "${CRASH_LOG}.tmp" "$CRASH_LOG"
		fi
		echo "$crash_line" >> "$ALERT_LOG"
	fi
	rm -f "$BREADCRUMB"
}

start_service() {
	detect_unclean_shutdown

	procd_open_instance
	procd_set_param command /bin/sh -c '
LOG="'"$HEALTH_LOG"'"
ALERTS="'"$ALERT_LOG"'"
CRUMB="'"$BREADCRUMB"'"
INT='"$INTERVAL"'
MAXL='"$MAX_LINES"'
MAXB='"$MAX_BYTES"'
MAXA='"$MAX_ALERT_LINES"'
CRUMB_INT='"$BREADCRUMB_INTERVAL"'
xpid_prev=""
tick=0
last_restart_tick=0
last_failsafe_tick=0
xray_down_streak=0
redsocks_down_streak=0
last_redsocks_restart_tick=0
FAILSAFE_HOLD_SECONDS=300
AI_CHECK_EVERY_TICKS=2

. /usr/share/vpn-xray/lib-common.sh

alert() {
	echo "$(date +%s)	$*" >> "$ALERTS"
	lc=$(wc -l < "$ALERTS" 2>/dev/null || echo 0)
	if [ "$lc" -gt "$MAXA" ]; then
		tail -n "$((MAXA / 2))" "$ALERTS" > "${ALERTS}.tmp"
		mv "${ALERTS}.tmp" "$ALERTS"
	fi
}

rotate() {
	[ -f "$LOG" ] || return 0
	sz=$(wc -c < "$LOG" 2>/dev/null || echo 0)
	lc=$(wc -l < "$LOG" 2>/dev/null || echo 0)
	if [ "$sz" -gt "$MAXB" ] || [ "$lc" -gt "$MAXL" ]; then
		tail -n "$((MAXL / 2))" "$LOG" > "${LOG}.tmp"
		mv "${LOG}.tmp" "$LOG"
	fi
}

rotate_xray_logs() {
	local f sz
	for f in /etc/xray/logs/codex-xray-access.log /etc/xray/logs/codex-xray-error.log; do
		[ -f "$f" ] || continue
		sz=$(stat -c%s "$f" 2>/dev/null) || continue
		[ "${sz:-0}" -gt 20971520 ] || continue
		: > "$f"
		alert "XRAY_LOG_ROTATED $(basename "$f") sz=${sz}"
	done
}

# Reachable = any final HTTP status except 403/5xx. Unauthenticated
# probes normally answer 401; 403 means the edge rejects our egress IP
# and 5xx/000 mean the endpoint is effectively down — all three are
# "claude/codex недоступен" from the client point of view.
ai_probe() {
	local url="$1" try code
	for try in 1 2; do
		code=$(curl -ksS -o /dev/null -w "%{http_code}" -m 8 \
			--socks5-hostname 127.0.0.1:1084 "$url" 2>/dev/null)
		case "$code" in
			[1234][0-9][0-9])
				[ "$code" != "403" ] && return 0
				;;
		esac
		sleep 2
	done
	return 1
}

guard_restart_xray() {
	local reason="$1"
	local cooldown=$((CRUMB_INT * 2))
	xray_failsafe_hold_active && return 0
	if [ $((tick - last_restart_tick)) -lt "$cooldown" ]; then
		return 0
	fi
	alert "GUARD_RESTART reason=$reason"
	/etc/init.d/codex-xray restart >/dev/null 2>&1 || true
	last_restart_tick=$tick
}

# redsocks is half the transparent path: if it dies the client loses
# egress even while xray is fine. Nothing else brings it back (the switch
# watchdog only reacts to switch changes, and an interrupted install can
# leave it stopped), so recover it here on its own cooldown.
guard_restart_redsocks() {
	local reason="$1"
	local cooldown=$((CRUMB_INT * 2))
	xray_failsafe_hold_active && return 0
	if [ $((tick - last_redsocks_restart_tick)) -lt "$cooldown" ]; then
		return 0
	fi
	alert "GUARD_RESTART_REDSOCKS reason=$reason"
	/etc/init.d/codex-transproxy restart >/dev/null 2>&1 || true
	last_redsocks_restart_tick=$tick
}

guard_failsafe_hold() {
	local reason="$1"
	local cooldown=$((FAILSAFE_HOLD_SECONDS / INT))
	[ "$cooldown" -ge 1 ] 2>/dev/null || cooldown=10
	if [ $((tick - last_failsafe_tick)) -lt "$cooldown" ]; then
		return 0
	fi
	alert "GUARD_FAILSAFE_HOLD reason=$reason hold=${FAILSAFE_HOLD_SECONDS}s"
	xray_failsafe_enable "$reason"
	xray_failsafe_hold_set "$reason" "$FAILSAFE_HOLD_SECONDS"
	/etc/init.d/codex-transproxy stop >/dev/null 2>&1 || true
	/etc/init.d/codex-xray stop >/dev/null 2>&1 || true
	last_failsafe_tick=$tick
}

: > "$LOG"
: > "$ALERTS"

while true; do
	eval $(awk "/MemTotal/{t=\$2}/MemAvailable/{a=\$2}END{printf \"mt=%d ma=%d\",t,a}" /proc/meminfo)

	la=$(cut -d" " -f1 /proc/loadavg)

	xpid=$(cat /var/run/codex-xray.pid 2>/dev/null) || xpid=""
	xrss=0; xfd=0; xth=0; xup=0
	if [ -n "$xpid" ] && kill -0 "$xpid" 2>/dev/null; then
		xrss=$(awk "/VmRSS/{print \$2}" /proc/$xpid/status 2>/dev/null) || xrss=0
		xfd=$(ls /proc/$xpid/fd 2>/dev/null | wc -l) || xfd=0
		xth=$(awk "/Threads/{print \$2}" /proc/$xpid/status 2>/dev/null) || xth=0
		xup=1
	fi

	ct=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null) || ct=0
	rxe=$(dmesg 2>/dev/null | grep -c CheckRxError) || rxe=0

	rpid=$(cat /var/run/redsocks.pid 2>/dev/null) || rpid=""
	[ -n "$rpid" ] && kill -0 "$rpid" 2>/dev/null && rup=1 || rup=0

	if timeout 3 wget -q -O /dev/null http://connectivitycheck.gstatic.com/generate_204 2>/dev/null; then
		cok=1
	else
		cok=0
	fi

	now=$(date +%s)
	printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
		"$now" "$ma" "$la" "$xrss" "$xfd" "$xth" "$ct" "$rxe" "$xup" "$rup" "$cok" >> "$LOG"

	# --- Alerts (observational) ---
	[ "$ma" -lt 80000 ] && alert "LOW_MEM avail=${ma}kB"
	[ "${xrss:-0}" -gt 60000 ] 2>/dev/null && alert "XRAY_RSS_HIGH ${xrss}kB"
	[ "${xfd:-0}" -gt 500 ] 2>/dev/null && alert "XRAY_FD_HIGH $xfd"
	[ "${ct:-0}" -gt 12000 ] 2>/dev/null && alert "CONNTRACK_HIGH $ct"
	[ "$xup" = "0" ] && alert "XRAY_DOWN"
	[ "$rup" = "0" ] && alert "REDSOCKS_DOWN"
	[ -n "$xpid_prev" ] && [ "$xpid" != "$xpid_prev" ] && alert "XRAY_RESTARTED old=$xpid_prev new=$xpid"

	# --- Proactive guards (preventive) ---
	# Guard 1: critically low memory — fail closed and stop the path before OOM.
	if [ "$ma" -lt 50000 ] 2>/dev/null; then
		guard_failsafe_hold "LOW_MEM_CRITICAL avail=${ma}kB"
	fi

	# Guard 2: xray RSS runaway — restart before it starves the system
	if [ "${xrss:-0}" -gt 80000 ] 2>/dev/null && [ "$xup" = "1" ]; then
		guard_restart_xray "XRAY_RSS_RUNAWAY ${xrss}kB"
	fi

	# Guard 3: fd leak — restart before file descriptor exhaustion
	if [ "${xfd:-0}" -gt 800 ] 2>/dev/null && [ "$xup" = "1" ]; then
		guard_restart_xray "XRAY_FD_RUNAWAY $xfd"
	fi

	# Guard 4: conntrack nearing max — flush stale entries
	if [ "${ct:-0}" -gt 14000 ] 2>/dev/null; then
		conntrack -F >/dev/null 2>&1 || true
		alert "GUARD_CONNTRACK_FLUSH ct=$ct"
	fi

	# --- AI-path diagnostic capture ---
	# Two triggers, both throttled by the capture-script lock + the
	# 30-minute rate limit, so backgrounding on every hit is safe. Skipped
	# under a failsafe hold (the path is intentionally down there).
	if [ $((tick % AI_CHECK_EVERY_TICKS)) -eq 0 ] && ! xray_failsafe_hold_active; then
		if [ "$xup" = "1" ] && [ "$rup" = "1" ]; then
			# Path daemons are up: reachability is the question. Probe the AI
			# endpoints and capture only when one is actually unreachable.
			claude_ok=1; codex_ok=1
			ai_probe https://api.anthropic.com/v1/models || claude_ok=0
			ai_probe https://api.openai.com/v1/models || codex_ok=0
			if [ "$claude_ok" = "0" ] || [ "$codex_ok" = "0" ]; then
				alert "AI_UNREACHABLE claude=$claude_ok codex=$codex_ok"
				/usr/share/vpn-xray/xray-diag-capture.sh "ai-claude${claude_ok}-codex${codex_ok}" >/dev/null 2>&1 &
			fi
		else
			# A path daemon is down: claude/codex are unreachable by
			# definition. Skip the (pointless) probes and capture the state
			# that explains why — this is exactly the redsocks-down case that
			# previously went uncaptured.
			/usr/share/vpn-xray/xray-diag-capture.sh "path-down-xu${xup}-ru${rup}" >/dev/null 2>&1 &
		fi
	fi

	# Guard 5: xray down for >2 consecutive checks — attempt restart
	if [ "$xup" = "0" ]; then
		xray_down_streak=$((xray_down_streak + 1))
		if [ "$xray_down_streak" -ge 3 ]; then
			guard_restart_xray "XRAY_DOWN_SUSTAINED streak=$xray_down_streak"
			xray_down_streak=0
		fi
	else
		xray_down_streak=0
	fi

	# Guard 6: redsocks down for >2 consecutive checks — attempt restart.
	# Only when xray is up: if xray itself is down, Guard 5 owns recovery
	# and codex-transproxy has nothing to point redsocks at yet.
	if [ "$rup" = "0" ] && [ "$xup" = "1" ]; then
		redsocks_down_streak=$((redsocks_down_streak + 1))
		if [ "$redsocks_down_streak" -ge 3 ]; then
			guard_restart_redsocks "REDSOCKS_DOWN_SUSTAINED streak=$redsocks_down_streak"
			redsocks_down_streak=0
		fi
	else
		redsocks_down_streak=0
	fi

	xpid_prev="$xpid"
	tick=$((tick + 1))

	# --- Persistent breadcrumb (crash forensics) ---
	if [ $((tick % CRUMB_INT)) -eq 0 ]; then
		up=$(cut -d. -f1 /proc/uptime)
		{
			printf "epoch=%s\n" "$now"
			printf "uptime=%s\n" "$up"
			printf "state=ma%s_xr%s_ct%s_xu%s_ru%s_co%s\n" \
				"$ma" "${xrss:-0}" "${ct:-0}" "$xup" "$rup" "$cok"
		} > "${CRUMB}.tmp"
		mv "${CRUMB}.tmp" "$CRUMB"
		sync
	fi

	rotate
	rotate_xray_logs

	sleep "$INT"
done
'
	procd_set_param respawn 10 5 0
	procd_close_instance
}
