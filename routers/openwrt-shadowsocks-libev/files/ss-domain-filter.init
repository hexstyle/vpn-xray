#!/bin/sh /etc/rc.common

START=97
STOP=08

start() {
	if command -v timeout >/dev/null 2>&1; then
		timeout 180 /usr/bin/router-rules sync-apply-shadowsocks >/tmp/ss-domain-filter.log 2>&1 || return 1
	else
		/usr/bin/router-rules sync-apply-shadowsocks >/tmp/ss-domain-filter.log 2>&1 || return 1
	fi
}

restart() {
	start
}
