#!/bin/sh /etc/rc.common

START=94
STOP=11
USE_PROCD=1

NAME='codex-xray-tunnel'
CONFIG='/etc/xray/codex-xray-tunnel.env'

config_value() {
	sed -n "s/^$1=//p" "$CONFIG" 2>/dev/null | sed -n '1p'
}

start_service() {
	[ -s "$CONFIG" ] || return 0
	DIAL_MODE="$(config_value DIAL_MODE)"
	SSH_HOST="$(config_value SSH_HOST)"; SSH_PORT="$(config_value SSH_PORT)"
	SSH_USER="$(config_value SSH_USER)"; SSH_KEY="$(config_value SSH_KEY)"
	REMOTE_PORT="$(config_value REMOTE_PORT)"; LOCAL_PORT="$(config_value LOCAL_PORT)"
	[ "$DIAL_MODE" = 'ssh_tunnel' ] || return 0
	case "${SSH_PORT:-}:${REMOTE_PORT:-}:${LOCAL_PORT:-}" in
		*[!0-9:]*) return 1 ;;
	esac
	case "$SSH_HOST" in ''|*[!A-Za-z0-9._:-]*) return 1;; esac
	case "$SSH_HOST" in *:*) return 1;; esac
	case "$SSH_USER" in ''|*[!A-Za-z0-9._-]*) return 1;; esac
	case "$SSH_KEY" in /etc/xray/ssh-keys/*) ;; *) return 1;; esac
	case "$SSH_KEY" in *[!A-Za-z0-9._/-]*) return 1;; esac
	[ -s "$SSH_KEY" ] || return 1

	procd_open_instance
	procd_set_param command /usr/bin/ssh -NT \
		-o BatchMode=yes -o StrictHostKeyChecking=yes \
		-o UserKnownHostsFile=/etc/xray/known_hosts \
		-o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
		-p "$SSH_PORT" -i "$SSH_KEY" \
		-L "127.0.0.1:${LOCAL_PORT}:127.0.0.1:${REMOTE_PORT}" \
		"${SSH_USER}@${SSH_HOST}"
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vpn-xray
}
