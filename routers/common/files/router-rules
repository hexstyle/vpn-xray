#!/bin/sh

set -e

PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

CONFIG_PKG='router_rules'
CONFIG_SECTION='global'
DEFAULT_REPO_FETCH_URL='REPLACE_WITH_RULES_REPO_FETCH_URL'
DEFAULT_REPO_PUSH_URL=''
DEFAULT_REPO_BRANCH='main'
DEFAULT_REPO_PATH='/etc/router-rules/repo'
DEFAULT_RULES_RELPATH='lists/shared-targets.txt'
DEFAULT_GENERATED_DIR='/etc/router-rules/generated'
DEFAULT_SSH_KEY_PATH='/etc/router-rules/ssh/routerRules_ed25519'
DEFAULT_KNOWN_HOSTS='/etc/router-rules/ssh/known_hosts'
DEFAULT_GIT_USER_NAME='router-rules'
DEFAULT_GIT_USER_EMAIL='router-rules@example.invalid'
DEFAULT_DNS_RESOLVER='9.9.9.9 208.67.222.222'
DEFAULT_DEVICE_ID='router'
DEFAULT_ENABLE_PUSH='0'
DEFAULT_XRAY_MODE='full'
DEFAULT_XRAY_IPSET='xray_selective_dst'
DEFAULT_XRAY_DNSMASQ_CONF='/tmp/dnsmasq.d/router-rules-xray-ipset.conf'
DEFAULT_XRAY_DNSMASQ_SERVER_CONF='/tmp/dnsmasq.d/router-rules-public-dns.conf'
DEFAULT_SYNC_INTERVAL='30'
DEFAULT_EXTERNAL_SOURCE_ENABLED='0'
DEFAULT_EXTERNAL_SOURCE_URL=''
DEFAULT_EXTERNAL_SOURCE_INTERVAL='86400'
EXTERNAL_SOURCE_REPO_LAYOUT_VERSION='2'
DEFAULT_GIT_AUTH_MODE='auto'
DEFAULT_GIT_HTTP_USERNAME=''
DEFAULT_GIT_HTTP_PASSWORD=''
DEFAULT_GIT_ASKPASS='/tmp/router-rules-git-askpass.sh'
EXTERNAL_SOURCE_SCRIPT='/usr/share/vpn-xray/router-rules-external.py'
DEFAULT_EXTERNAL_SOURCE_TIMEOUT='90'
EXTERNAL_SCRIPT_TIMEOUT='60'
EXTERNAL_SCRIPT_MAX_TARGETS='5000'
SCRIPTS_DIR_RELPATH='scripts'
STATUS_FILE='/tmp/router-rules.status'
EXTERNAL_SYNC_PID_FILE='/tmp/router-rules-external-sync.pid'
DEFAULT_RULES_BACKUP_DIR='/etc/router-rules/backups'
DEFAULT_RULES_BACKUP_KEEP='20'

. "${VX_LIB_COMMON:-/usr/share/vpn-xray/lib-common.sh}"

# Temp file helpers with identifiable prefix for stale cleanup.

# Function library split into sourced libs (AGENTS.md 500-line rule).
# Override VX_RULES_LIB_DIR in tests to point at the repo copy.
: "${VX_RULES_LIB_DIR:=/usr/share/vpn-xray}"
. "$VX_RULES_LIB_DIR/router-rules-config.sh"
. "$VX_RULES_LIB_DIR/router-rules-git.sh"
. "$VX_RULES_LIB_DIR/router-rules-repo.sh"
. "$VX_RULES_LIB_DIR/router-rules-remote.sh"
. "$VX_RULES_LIB_DIR/router-rules-rulestree.sh"
. "$VX_RULES_LIB_DIR/router-rules-external-a.sh"
. "$VX_RULES_LIB_DIR/router-rules-external-b.sh"
. "$VX_RULES_LIB_DIR/router-rules-ipset.sh"
. "$VX_RULES_LIB_DIR/router-rules-apply.sh"
. "$VX_RULES_LIB_DIR/router-rules-status.sh"
with_lock() {
	local cmd="$1" max_wait
	shift

	max_wait="${ROUTER_RULES_LOCK_WAIT:-60}"
	case "$max_wait" in
		''|*[!0-9]*)
			max_wait=60
			;;
	esac

	with_flock '/tmp/router-rules.flock' "$max_wait" "$cmd" "$@"
}

usage() {
	cat <<'EOF'
router-rules commands:
  status-json
  check-remote-rules
  ensure-git-key
  sync
  resolve
  build-xray-ipset
  apply-xray
  cutover-xray
  sync-apply-xray
  background-tick
  preview-external-source <source-id>
  read-external-source <source-id>
  sync-external-source
  save-file <path>
  set-xray-mode <full|selective>
  set-mode-cutover <full|selective>
  recover-manual-rules
  restore-lkg
EOF
}

if [ "${ROUTER_RULES_LIB_ONLY:-0}" = '1' ]; then
	return 0 2>/dev/null || exit 0
fi

cmd="${1:-}"

# Purge stale temp files from previous crashed runs (older than 10 min).
find /tmp -maxdepth 1 \( -name 'rr-*' -o -name 'rrd-*' \) -mmin +10 -exec rm -rf {} + 2>/dev/null || true

case "$cmd" in
	status-json)
		# Guard: abort immediately if another status-json is already running.
		# Prevents process pile-up that can OOM a low-memory router.
		_sj_lock='/tmp/router-rules-status.flock'
		exec 9>"$_sj_lock"
		if ! flock -n 9; then
			printf '{"ok":false,"error":"busy","error_message":"Another status query is still running."}'
			exit 0
		fi
		status_json
		;;
	check-remote-rules)
		with_lock check_remote_rules_internal
		;;
	ensure-git-key)
		with_lock ensure_git_key_internal
		;;
	sync)
		with_lock sync_repo_internal
		;;
	resolve)
		with_lock resolve_rules_internal
		;;
	build-xray-ipset)
		with_lock build_xray_ipset_internal
		;;
	apply-xray)
		with_lock apply_xray_internal
		;;
	cutover-xray)
		with_lock hard_cutover_xray_internal
		;;
	sync-apply-xray)
		with_lock sync_apply_xray_internal
		;;
	background-tick)
		with_lock background_tick_internal
		;;
	enable-selective-fallback)
		shift
		with_lock enable_selective_fallback_internal "${1:-rules repository unreachable during install}"
		;;
	clear-selective-fallback)
		with_lock clear_selective_fallback_internal
		;;
	selective-fallback-retry)
		with_lock selective_fallback_retry_internal
		;;
	preview-external-source)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		preview_external_source_internal "$1"
		;;
	read-external-source)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		read_external_source_internal "$1"
		;;
	read-external-script)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		read_external_script_internal "$1"
		;;
	external-source-ids)
		external_source_catalog | while IFS='|' read -r _eid _elabel _eurl || [ -n "$_eid" ]; do
			[ -n "$_eid" ] && printf '%s\n' "$_eid"
		done
		;;
	sync-external-source)
		sync_external_source_internal
		;;
	validate-external-script)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		validate_external_script_internal "$1"
		;;
	save-external-script)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		with_lock save_external_script_internal "$1"
		;;
	delete-external-script)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		with_lock delete_external_script_internal "$1"
		;;
	migrate-external-catalog)
		with_lock migrate_external_catalog_internal
		;;
	save-sync-apply-xray)
		shift
		[ $# -ge 1 ] || usage
		with_lock save_sync_apply_xray_internal "$1"
		;;
	save-file)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		with_lock save_rules_file_internal "$1"
		;;
	set-xray-mode)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		with_lock set_xray_mode_internal "$1"
		;;
	set-mode-cutover)
		shift
		[ -n "${1:-}" ] || { usage >&2; exit 1; }
		with_lock set_mode_cutover_internal "$1"
		;;
	recover-manual-rules)
		with_lock recover_empty_manual_rules_internal 'operator-request'
		;;
	restore-lkg)
		with_lock restore_lkg_internal
		;;
	*)
		usage >&2
		exit 1
		;;
esac
