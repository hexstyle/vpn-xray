compute_unique_rule_additions_internal() {
	local base_file="$1"
	local candidate_file="$2"
	local out_file="$3"

	awk '
		function trim(s) {
			sub(/\r$/, "", s)
			sub(/^[[:space:]]+/, "", s)
			sub(/[[:space:]]+$/, "", s)
			return s
		}
		FILENAME == ARGV[1] {
			line = trim($0)
			if (line == "" || line ~ /^#/) {
				next
			}
			seen[tolower(line)] = 1
			next
		}
		{
			line = trim($0)
			if (line == "" || line ~ /^#/) {
				next
			}
			norm = tolower(line)
			if (!(norm in seen) && !(norm in emitted)) {
