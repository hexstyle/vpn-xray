: "${VPS_PROFILE:=debian-13}"
: "${VPS_PROFILE_LABEL:=Debian 13}"
: "${VPS_DEFAULT_SERVER_NAME:=www.microsoft.com}"
: "${XRAY_PORT:=24443}"
: "${XRAY_FLOW:=}"
: "${VPS_OS_FAMILY:=debian}"
: "${VPS_OS_ID:=debian}"
: "${VPS_OS_VERSION_PREFIX:=13}"
: "${VPS_REQUIRED_PKG_MGR:=apt-get}"
: "${VPS_REQUIRES_SYSTEMD:=1}"
: "${VPS_SUPPORTED_ARCH_REGEX:=x86_64|aarch64}"
