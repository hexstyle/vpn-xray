{
  "log": {
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": ${XRAY_PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${XRAY_UUID}"${XRAY_CLIENT_FLOW_BLOCK}
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "${VPS_TLS_CERT_PATH}",
              "keyFile": "${VPS_TLS_KEY_PATH}"
            }
          ],
          "alpn": ["h2", "http/1.1"],
          "minVersion": "1.2"
        },
        "wsSettings": {
          "path": "${XRAY_WS_PATH}",
          "host": "${XRAY_SERVER_NAME}"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    }
  ]
}
