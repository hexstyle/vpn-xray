{
  "log": {
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": ${XRAY_PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${XRAY_UUID}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "${XRAY_SERVER_NAME}:443",
          "xver": 0,
          "serverNames": [
            "${XRAY_SERVER_NAME}"
          ],
          "privateKey": "${XRAY_PRIVATE_KEY}",
          "shortIds": [
            "${XRAY_SHORT_ID}"
          ],
          "limitFallbackUpload": {
            "afterBytes": 1048576,
            "bytesPerSec": 16384,
            "burstBytesPerSec": 32768
          },
          "limitFallbackDownload": {
            "afterBytes": 1048576,
            "bytesPerSec": 16384,
            "burstBytesPerSec": 32768
          }
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom"
    }
  ]
}
